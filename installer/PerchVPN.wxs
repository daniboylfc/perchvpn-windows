<?xml version="1.0" encoding="UTF-8"?>
<Wix xmlns="http://wixtoolset.org/schemas/v4/wxs">
  <Package
      Name="$(var.ProductName)"
      Manufacturer="$(var.Manufacturer)"
      Version="$(var.Version)"
      Language="1033"
      InstallerVersion="500"
      Scope="perMachine"
      UpgradeCode="{12FCCBC8-3CAF-40ED-AB2A-F5A388D60DEC}">
    <MajorUpgrade
        DowngradeErrorMessage="A newer version of $(var.ProductName) is already installed."
        Schedule="afterInstallInitialize" />
    <MediaTemplate EmbedCab="yes" CompressionLevel="high" />

    <!-- WebView2 Evergreen Runtime prerequisite.  Without it the window cannot
         be created at all, and on a clean machine the failure used to look
         like a silent exit.  Per-machine installs land under WOW6432Node
         (Edge Update is 32-bit); per-user runtimes live under HKCU. -->
    <Property Id="WEBVIEW2_MACHINE">
      <RegistrySearch
          Id="WebView2MachineSearch"
          Root="HKLM"
          Key="SOFTWARE\WOW6432Node\Microsoft\EdgeUpdate\Clients\{F3017226-FE2A-4295-8BDF-00C3A9A7E4C5}"
          Name="pv"
          Type="raw"
          Bitness="always64" />
    </Property>
    <Property Id="WEBVIEW2_USER">
      <RegistrySearch
          Id="WebView2UserSearch"
          Root="HKCU"
          Key="SOFTWARE\Microsoft\EdgeUpdate\Clients\{F3017226-FE2A-4295-8BDF-00C3A9A7E4C5}"
          Name="pv"
          Type="raw"
          Bitness="always64" />
    </Property>
    <Launch
        Condition="Installed OR WEBVIEW2_MACHINE OR WEBVIEW2_USER"
        Message="$(var.ProductName) needs the Microsoft Edge WebView2 Evergreen Runtime to display its window. Install it from https://go.microsoft.com/fwlink/p/?LinkId=2124703 and run this installer again." />

    <Feature Id="MainFeature" Title="$(var.ProductName)" Level="1">
      <ComponentGroupRef Id="ProductComponents" />
      <ComponentGroupRef Id="ShortcutComponents" />
    </Feature>
  </Package>

  <Fragment>
    <StandardDirectory Id="ProgramFiles64Folder">
      <Directory Id="INSTALLFOLDER" Name="$(var.ProductName)" />
    </StandardDirectory>

    <StandardDirectory Id="ProgramMenuFolder">
      <Directory Id="ApplicationProgramsFolder" Name="$(var.ProductName)" />
    </StandardDirectory>

    <ComponentGroup Id="ProductComponents" Directory="INSTALLFOLDER">
      <Files Include="!(bindpath.SourceDir)\**" />
    </ComponentGroup>

    <ComponentGroup Id="ShortcutComponents">
      <Component Id="StartMenuShortcut" Directory="ApplicationProgramsFolder" Guid="{BC3BF1C2-FC92-4DE8-AE2C-8A95FF27FE8A}">
        <Shortcut
            Id="StartMenuShortcut"
            Name="$(var.ProductName)"
            Target="[INSTALLFOLDER]PerchVPN.exe"
            WorkingDirectory="INSTALLFOLDER" />
        <RemoveFolder Id="RemoveApplicationProgramsFolder" Directory="ApplicationProgramsFolder" On="uninstall" />
        <RegistryValue
            Root="HKLM"
            Key="Software\$(var.Manufacturer)\$(var.ProductName)"
            Name="StartMenu"
            Type="integer"
            Value="1"
            KeyPath="yes" />
      </Component>

      <Component Id="DesktopShortcut" Directory="DesktopFolder" Guid="{F34C10DE-AF77-46CB-A1D0-EA0736C2BCE7}">
        <Shortcut
            Id="DesktopShortcut"
            Name="$(var.ProductName)"
            Target="[INSTALLFOLDER]PerchVPN.exe"
            WorkingDirectory="INSTALLFOLDER" />
        <RegistryValue
            Root="HKLM"
            Key="Software\$(var.Manufacturer)\$(var.ProductName)"
            Name="Desktop"
            Type="integer"
            Value="1"
            KeyPath="yes" />
      </Component>
    </ComponentGroup>
  </Fragment>
</Wix>
